{
	"name": "fuma",
	"version": "2.0.50",
	"description": "My fullstack material build with sveltekit, daisyui, zod, prisma, lucia",
	"author": {
		"name": "Jonas Voisard",
		"email": "jonas.voisard@gmail.com"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build && npm run package",
		"preview": "vite preview --host",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"migrate": "prisma migrate dev",
		"generate": "prisma generate",
		"studio": "prisma studio",
		"seed": "prisma db seed",
		"biome": "biome"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./ui": {
			"types": "./dist/ui/index.d.ts",
			"svelte": "./dist/ui/index.js",
			"default": "./dist/ui/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"default": "./dist/utils/index.js"
		},
		"./state": {
			"types": "./dist/state/index.d.ts",
			"default": "./dist/state/index.js"
		},
		"./validation": {
			"types": "./dist/validation/index.d.ts",
			"default": "./dist/validation/index.js"
		},
		"./action": {
			"types": "./dist/action/index.d.ts",
			"default": "./dist/action/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"daisyui": "^5.5.17",
		"tailwindcss": "^4.1.18",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.56.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.2",
		"daisyui": "^5.5.19",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.1.16",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"@faker-js/faker": "^10.4.0",
		"@lucide/svelte": "^1.7.0",
		"@tiptap/core": "^2.27.2",
		"@tiptap/extension-color": "^2.27.2",
		"@tiptap/extension-highlight": "^2.27.2",
		"@tiptap/extension-image": "^2.27.2",
		"@tiptap/extension-link": "^2.27.2",
		"@tiptap/extension-mention": "^2.27.2",
		"@tiptap/extension-placeholder": "^2.27.2",
		"@tiptap/extension-text-align": "^2.27.2",
		"@tiptap/extension-text-style": "^2.27.2",
		"@tiptap/extension-youtube": "^2.27.2",
		"@tiptap/html": "^2.27.2",
		"@tiptap/pm": "^2.27.2",
		"@tiptap/starter-kit": "^2.27.2",
		"@tiptap/suggestion": "^2.27.2",
		"dayjs": "^1.11.20",
		"debounce": "^3.0.0",
		"devalue": "^5.7.0",
		"dotenv": "^17.4.1",
		"fuse.js": "^7.3.0",
		"litepicker": "^2.0.12",
		"perod": "^1.4.1",
		"runed": "^0.37.1",
		"svelte": "^5.55.2",
		"svelte-easy-crop": "^5.0.1",
		"svelte-sonner": "^1.1.0",
		"tippy.js": "^6.3.7",
		"zod": "^4.3.6"
	}
}
